# Local service endpoints. Leave keys empty when a service is not available.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENSEARCH_URL=http://localhost:9200

# Optional model overrides.
TTSQL_PLANNER_MODEL=auto/smart
TTSQL_NARRATOR_MODEL=auto/best-fast

# Chainlit settings are server-controlled; users cannot change them in the UI.
TTSQL_CHAINLIT_PRINCIPAL=analyst_full
TTSQL_SCENARIO=golden
TTSQL_RETRIEVAL_PROVIDER=inmemory
TTSQL_USE_LLM=true
TTSQL_USE_EMBEDDINGS=true
TTSQL_CHAINLIT_SHOW_SQL=true
TTSQL_CHAINLIT_MAX_ROWS=100

# LangSmith is optional. LANGSMITH_TRACING is preferred over LANGCHAIN_TRACING_V2.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=texttosql-chainlit
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_TRACING_V2=true
